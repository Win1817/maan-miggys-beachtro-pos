<Window x:Class="Beachtro.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Beachtro POS" Height="800" Width="1280" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}">
    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Banner}" Padding="12,6"
                Visibility="{Binding IsTestProfile, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding BannerText}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
        </Border>
        <Border DockPanel.Dock="Top" Background="{StaticResource Accent}" Padding="12,6"
                Visibility="{Binding ShowNavigation, Converter={StaticResource Visible}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OperatorName}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding BusinessDate}" Foreground="#CCFBF1" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Lock (Ctrl+L)" Style="{StaticResource Nav}" Command="{Binding LockCommand}" />
                    <Button Content="Sign out" Style="{StaticResource Nav}" Command="{Binding SignOutCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Beachtro POS" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,20,0" />
                    <Button Content="Sell" Style="{StaticResource Nav}" Command="{Binding ShowPos}" />
                    <Button Content="Orders" Style="{StaticResource Nav}" Command="{Binding ShowOrders}" />
                    <Button Content="Shifts" Style="{StaticResource Nav}" Command="{Binding ShowShifts}" />
                    <Button Content="Dashboard" Style="{StaticResource Nav}" Command="{Binding ShowDashboard}" />
                    <Button Content="Reports" Style="{StaticResource Nav}" Command="{Binding ShowReports}" />
                    <Button Content="Products" Style="{StaticResource Nav}" Command="{Binding ShowProducts}" />
                    <Button Content="Inventory" Style="{StaticResource Nav}" Command="{Binding ShowInventory}" />
                    <Button Content="Users" Style="{StaticResource Nav}" Command="{Binding ShowUsers}" />
                    <Button Content="Recovery" Style="{StaticResource Nav}" Command="{Binding ShowRecovery}" />
                    <Button Content="Settings" Style="{StaticResource Nav}" Command="{Binding ShowSettings}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</Window>

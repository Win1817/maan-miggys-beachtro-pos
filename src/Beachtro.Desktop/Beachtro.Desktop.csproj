<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF shell and composition root. Views/view models only; no DbContext use in UI (T-19). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Beachtro.Desktop</RootNamespace>
    <AssemblyName>BeachtroPOS</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Beachtro.Application\Beachtro.Application.csproj" />
    <ProjectReference Include="..\Beachtro.Infrastructure\Beachtro.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>

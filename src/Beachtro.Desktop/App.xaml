<Application x:Class="Beachtro.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Beachtro.Desktop.ViewModels"
             xmlns:v="clr-namespace:Beachtro.Desktop.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Palette -->
        <SolidColorBrush x:Key="Accent" Color="#0F766E" />
        <SolidColorBrush x:Key="AccentDark" Color="#115E59" />
        <SolidColorBrush x:Key="AccentSoft" Color="#CCFBF1" />
        <SolidColorBrush x:Key="Banner" Color="#B45309" />
        <SolidColorBrush x:Key="Page" Color="#F1F5F9" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Ink" Color="#0F172A" />
        <SolidColorBrush x:Key="Muted" Color="#475569" />
        <SolidColorBrush x:Key="Line" Color="#CBD5E1" />
        <SolidColorBrush x:Key="Danger" Color="#B91C1C" />
        <SolidColorBrush x:Key="DangerSoft" Color="#FEE2E2" />
        <SolidColorBrush x:Key="Success" Color="#15803D" />
        <SolidColorBrush x:Key="SuccessSoft" Color="#DCFCE7" />

        <v:MoneyConverter x:Key="Money" />
        <v:UnitsConverter x:Key="Units" />
        <v:LocalTimeConverter x:Key="LocalTime" />
        <v:PresentToVisibilityConverter x:Key="Visible" />
        <v:NotConverter x:Key="Not" />
        <vm:PasswordBoxesConverter x:Key="PasswordBoxes" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="Subheading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,6" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Touch-friendly flat buttons -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <!-- The app-wide TextBlock style would otherwise force dark ink on white-on-colour buttons. -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDark}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="ErrorBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
        </Style>

        <!-- View-model → view mapping -->
        <DataTemplate DataType="{x:Type vm:BootstrapViewModel}"><v:BootstrapView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}"><v:ChangePasswordView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LockViewModel}"><v:LockView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}"><v:PosView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}"><v:OrdersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}"><v:ProductsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}"><v:InventoryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><v:ReportsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftsViewModel}"><v:ShiftsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView /></DataTemplate>
    </Application.Resources>
</Application>

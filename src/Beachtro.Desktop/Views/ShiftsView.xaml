<UserControl x:Class="Beachtro.Desktop.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Shifts" Style="{StaticResource Heading}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{Binding ShiftPolicyText}" />
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding HasNoShift, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="Open your shift" Style="{StaticResource Subheading}" Margin="0,0,0,6" />
                    <TextBlock Text="Count the cash in the drawer before you start." Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Opening cash" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="140" Text="{Binding OpeningText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                        <Button Content="Open shift" Style="{StaticResource Primary}" Command="{Binding OpenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
            <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="*" />
                    <DataGridTextColumn Header="Opened (this PC)" Binding="{Binding OpenedUtc, Converter={StaticResource LocalTime}}" Width="130" />
                    <DataGridTextColumn Header="Closed" Binding="{Binding ClosedUtc, Converter={StaticResource LocalTime}, ConverterParameter=open}" Width="130" />
                    <DataGridTextColumn Header="Expected" Binding="{Binding Cash.ExpectedMinor, Converter={StaticResource Money}}" Width="100" />
                    <DataGridTextColumn Header="Counted" Binding="{Binding CountedMinor, Converter={StaticResource Money}}" Width="100" />
                    <DataGridTextColumn Header="Variance" Binding="{Binding VarianceMinor, Converter={StaticResource Money}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding DetailHeading}" Style="{StaticResource Subheading}" Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel Visibility="{Binding Detail, Converter={StaticResource Visible}}">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FAFAF9" Padding="12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Equation}" FontFamily="Consolas" FontSize="13" />
                        </Border>
                        <TextBlock Text="{Binding ClosedSummary}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding ClosedSummary, Converter={StaticResource Visible}}" />

                        <TextBlock Text="Cash in and out" Style="{StaticResource Label}" />
                        <DataGrid ItemsSource="{Binding Movements}" IsReadOnly="True" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding CreatedUtc, Converter={StaticResource LocalTime}}" Width="125" />
                                <DataGridTextColumn Header="In/Out" Binding="{Binding Direction}" Width="55" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding AmountMinor, Converter={StaticResource Money}}" Width="85" />
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding CanMoveCash, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Record cash in or out" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton Content="Cash in" IsChecked="True" GroupName="Dir" />
                                    <RadioButton Content="Cash out" IsChecked="{Binding MovementIsOut}" GroupName="Dir" />
                                </StackPanel>
                                <TextBlock Text="Amount" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding MovementAmount, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Reason" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding MovementReason, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="Record" Command="{Binding RecordMovementCommand}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#FFFBEB" BorderBrush="#FCD34D"
                                Visibility="{Binding Detail.Shift.IsOpen, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Close shift" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" Text="Count all cash in the drawer. A difference from the expected amount needs a reason." />
                                <TextBlock Text="Counted cash" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Reason (needed if the count differs, or for another cashier's shift)" Style="{StaticResource Label}" TextWrapping="Wrap" />
                                <TextBox Text="{Binding CloseReason, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Visibility="{Binding IsOthersOpenShift, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Confirm with your password" Style="{StaticResource Label}" />
                                    <PasswordBox x:Name="ClosePassword" />
                                </StackPanel>
                                <Button Content="Close shift" Style="{StaticResource DangerButton}" Command="{Binding CloseCommand}"
                                        CommandParameter="{Binding ElementName=ClosePassword}" Margin="0,10,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

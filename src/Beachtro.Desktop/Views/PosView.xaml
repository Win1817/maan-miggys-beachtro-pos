<UserControl x:Class="Beachtro.Desktop.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Categories -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Categories" Style="{StaticResource Subheading}" Margin="4,0,0,8" />
                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" BorderThickness="0" FontSize="15">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Padding="6,10" /></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Products -->
        <DockPanel Grid.Column="1" Margin="16">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,12">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Products}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="168" Height="104" Margin="0,0,12,12" Padding="10"
                                    Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <StackPanel Width="146">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="15" MaxHeight="42" />
                                    <TextBlock Text="{Binding UnitPriceMinor, Converter={StaticResource Money}}" FontSize="17" Foreground="{StaticResource Accent}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" Visibility="{Binding TrackStock, Converter={StaticResource Visible}}">
                                        <Run Text="In stock:" /> <Run Text="{Binding OnHandQ, Converter={StaticResource Units}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Cart and payment -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Dine-in" IsChecked="{Binding IsDineIn}" GroupName="OrderType" />
                    <RadioButton Content="Takeout" IsChecked="{Binding IsTakeout}" GroupName="OrderType" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" Padding="10,4" MinHeight="32" Margin="24,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource InfoBox}" Visibility="{Binding LastSale, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LastSale}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PrintStatusText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding AskPrintConfirmation, Converter={StaticResource Visible}}">
                                <Button Content="Printed OK" Command="{Binding ConfirmPrintedCommand}" CommandParameter="True" MinHeight="32" Padding="10,4" />
                                <Button Content="Did not print" Command="{Binding ConfirmPrintedCommand}" CommandParameter="False" MinHeight="32" Padding="10,4" />
                            </StackPanel>
                            <Button Content="Retry printing" Command="{Binding RetryPrintCommand}" MinHeight="32" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid Margin="0,4">
                        <TextBlock Text="Subtotal" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Subtotal}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2" Visibility="{Binding Discount, Converter={StaticResource Visible}}">
                        <TextBlock Text="Discount" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Discount}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,2" Visibility="{Binding Tax, Converter={StaticResource Visible}}">
                        <TextBlock Text="Tax" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Tax}" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,6,0,10">
                        <TextBlock Text="TOTAL" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="{Binding Total, StringFormat=PHP {0}}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton Content="Cash" IsChecked="{Binding IsCash}" GroupName="Method" />
                        <RadioButton Content="GCash" IsChecked="{Binding IsGCash}" GroupName="Method" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsCash, Converter={StaticResource Visible}}">
                        <TextBlock Text="Cash received" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}" FontSize="20" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Exact" Command="{Binding ExactCashCommand}" MinHeight="34" Padding="10,4" />
                            <Button Content="100" Command="{Binding QuickCashCommand}" CommandParameter="100" MinHeight="34" Padding="10,4" />
                            <Button Content="500" Command="{Binding QuickCashCommand}" CommandParameter="500" MinHeight="34" Padding="10,4" />
                            <Button Content="1000" Command="{Binding QuickCashCommand}" CommandParameter="1000" MinHeight="34" Padding="10,4" />
                        </StackPanel>
                        <TextBlock Text="{Binding ChangeText}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Success}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsGCash, Converter={StaticResource Visible}}">
                        <CheckBox Content="I confirmed the GCash payment arrived" IsChecked="{Binding GCashVerified}" FontWeight="SemiBold" />
                        <TextBlock Text="Reference (optional)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding GCashReference, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <Button Content="Complete sale" Style="{StaticResource Primary}" FontSize="18" MinHeight="54" Margin="0,12,0,0"
                            Command="{Binding CompleteCommand}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Cart}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Hint}"><Run Text="{Binding UnitPrice, Mode=OneWay}" /><Run Text=" each" /></TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="−" Width="36" MinHeight="34" Padding="0" Margin="0,0,4,0"
                                            Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Units}" Width="26" TextAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                                    <Button Content="+" Width="36" MinHeight="34" Padding="0" Margin="4,0,4,0"
                                            Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <Button Content="✕" Width="34" MinHeight="34" Padding="0" Foreground="{StaticResource Danger}"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LineTotal}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

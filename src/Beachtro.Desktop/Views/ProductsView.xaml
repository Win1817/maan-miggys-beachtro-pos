<UserControl x:Class="Beachtro.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Products" Style="{StaticResource Heading}" />
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPriceMinor, Converter={StaticResource Money}}" Width="90" />
                    <DataGridTextColumn Header="Tax" Binding="{Binding TaxKey}" Width="100" />
                    <DataGridCheckBoxColumn Header="Stock" Binding="{Binding TrackStock}" Width="60" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="New product" Command="{Binding NewCommand}" Margin="0" />
                        <TextBlock Text="{Binding EditHeading}" Style="{StaticResource Subheading}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="SKU" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Price (PHP)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Category" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" DisplayMemberPath="Name" />
                    <TextBlock Text="Tax entry" Style="{StaticResource Label}" />
                    <ComboBox ItemsSource="{Binding TaxKeys}" SelectedItem="{Binding TaxKey}" />
                    <CheckBox Content="Track stock for this product" IsChecked="{Binding TrackStock}" Margin="0,12,0,0" />
                    <CheckBox Content="Active (available for sale)" IsChecked="{Binding IsActive}" />
                    <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                    </Border>
                    <Button Content="Save product" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />

                    <TextBlock Text="Add category" Style="{StaticResource Subheading}" Margin="0,28,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCategoryCommand}" Margin="8,0,0,0" />
                        <TextBox Text="{Binding NewCategory, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Beachtro.Desktop.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Hint}" Text="You signed in with a temporary password. Replace it before continuing." />
                <TextBlock Text="Temporary (current) password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Current" />
                <TextBlock Text="New password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Next" />
                <TextBlock Text="Confirm new password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Confirm" />
                <TextBlock Text="{Binding PasswordRules}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Change password" Style="{StaticResource Primary}" IsDefault="True" Command="{Binding ChangeCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource PasswordBoxes}">
                                <Binding ElementName="Current" />
                                <Binding ElementName="Next" />
                                <Binding ElementName="Confirm" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Content="Sign out" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

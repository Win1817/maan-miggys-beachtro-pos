<UserControl x:Class="Beachtro.Desktop.Views.LockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#1E293B">
        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="Locked" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Hint}">
                    <Run Text="Signed in as" /> <Run Text="{Binding LockedUser, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Enter your password to continue." />
                </TextBlock>
                <TextBlock Text="Password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Password" />
                <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Unlock" Style="{StaticResource Primary}" IsDefault="True"
                            Command="{Binding UnlockCommand}" CommandParameter="{Binding ElementName=Password}" />
                    <Button Content="Sign out" Command="{Binding SignOutCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Beachtro.Desktop.Views.UpdateRollbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Border Style="{StaticResource Card}" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="This data is from a newer version" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SchemaDetail}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <TextBlock Text="Roll back to a backup made before the update" Style="{StaticResource Subheading}" />
                <TextBlock Text="Backup package (.zip)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rollback package" />
                </DockPanel>
                <TextBlock Text="Owner or Administrator username in that backup" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rollback username" />
                <TextBlock Text="Password in that backup" Style="{StaticResource Label}" />
                <PasswordBox x:Name="RollbackPassword" AutomationProperties.Name="Rollback password" />
                <TextBlock Text="Reason" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rollback reason" />
                <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
                <Button Content="Roll back to this backup" Style="{StaticResource DangerButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                        Command="{Binding RollbackCommand}" CommandParameter="{Binding ElementName=RollbackPassword}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

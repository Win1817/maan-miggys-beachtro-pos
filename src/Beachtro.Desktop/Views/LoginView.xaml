<UserControl x:Class="Beachtro.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Border Style="{StaticResource Card}" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
            <StackPanel>
                <TextBlock Text="Sign in" Style="{StaticResource Heading}" />
                <Border Style="{StaticResource InfoBox}" Visibility="{Binding Notice, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Text="Username" Style="{StaticResource Label}" />
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Password" />
                <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
                <Button Content="Sign in" Style="{StaticResource Primary}" Margin="0,16,0,0" IsDefault="True"
                        Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=Password}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Beachtro.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{StaticResource Page}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="Dashboard" Style="{StaticResource Heading}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Business date" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                <TextBox Width="130" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" ToolTip="YYYY-MM-DD" />
                <Button Content="Show" Command="{Binding RefreshCommand}" Margin="8,0,8,0" IsDefault="True" />
                <Button Content="Today" Command="{Binding TodayCommand}" />
                <Button Content="Close this business day" Command="{Binding CloseDayCommand}" Margin="24,0,0,0"
                        ToolTip="Records the day's figures and a data watermark. Nothing is locked; later refunds show as changes." />
            </StackPanel>
            <Border Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="230" Height="120" Margin="0,0,12,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource Muted}" FontSize="13" />
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                       Text="Refunds and voids count on the day they were made. Net collected includes tax; net revenue does not. Cloud sync is not set up in this build." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

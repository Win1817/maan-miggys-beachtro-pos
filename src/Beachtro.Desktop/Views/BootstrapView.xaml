<UserControl x:Class="Beachtro.Desktop.Views.BootstrapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Top" Padding="28" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Set up the owner account" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="This installation has no accounts yet. Create the Owner account. This screen appears only once; there are no default passwords." />
                <TextBlock Text="Username" Style="{StaticResource Label}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Display name" Style="{StaticResource Label}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Password" />
                <TextBlock Text="Confirm password" Style="{StaticResource Label}" />
                <PasswordBox x:Name="Confirm" />
                <TextBlock Text="{Binding PasswordRules}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </Border>
                <Button Content="Create owner account" Style="{StaticResource Primary}" Margin="0,16,0,0" IsDefault="True"
                        Command="{Binding CreateCommand}">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource PasswordBoxes}">
                            <Binding ElementName="Password" />
                            <Binding ElementName="Confirm" />
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Top" Padding="28">
            <StackPanel>
                <TextBlock Text="Replacing a PC?" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Restore the shop's last backup package instead of starting empty. Sign in with an Owner or Administrator account from that backup. Selling stays paused until you resolve what the old PC may have done after the backup." />
                <TextBlock Text="Backup package (.zip)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Backup package path" />
                </DockPanel>
                <TextBlock Text="Username in the backup" Style="{StaticResource Label}" />
                <TextBox Text="{Binding RestoreUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Backup username" />
                <TextBlock Text="Password in the backup" Style="{StaticResource Label}" />
                <PasswordBox x:Name="RestorePassword" AutomationProperties.Name="Backup password" />
                <TextBlock Text="Reason" Style="{StaticResource Label}" />
                <TextBox Text="{Binding RestoreReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Restore reason" />
                <Button Content="Restore from a backup" Margin="0,16,0,0" Command="{Binding RestoreCommand}" CommandParameter="{Binding ElementName=RestorePassword}" />
            </StackPanel>
        </Border>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="Beachtro.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="520" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Inventory" Style="{StaticResource Heading}" />
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="On hand" Binding="{Binding OnHandQ, Converter={StaticResource Units}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Selected.Name, FallbackValue='Select a product'}" Style="{StaticResource Subheading}" Margin="0" />
                    <TextBlock Text="Units to add (positive) or remove (negative)" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding DeltaText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Reason" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="This is the opening count (only before any other movement)" IsChecked="{Binding IsOpening}" />
                    <Border Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                    </Border>
                    <Border Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
                    </Border>
                    <Button Content="Record stock change" Style="{StaticResource Primary}" Command="{Binding ApplyCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="History" Style="{StaticResource Subheading}" Margin="0,20,0,6" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Movements}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding CreatedUtc, Converter={StaticResource LocalTime}}" Width="130" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" />
                        <DataGridTextColumn Header="Change" Binding="{Binding DeltaQ, Converter={StaticResource Units}}" Width="70" />
                        <DataGridTextColumn Header="After" Binding="{Binding BalanceAfterQ, Converter={StaticResource Units}}" Width="60" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

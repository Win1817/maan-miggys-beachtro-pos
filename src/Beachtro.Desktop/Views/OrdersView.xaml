<UserControl x:Class="Beachtro.Desktop.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="560" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Orders" Style="{StaticResource Heading}" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Business date" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
                <TextBox Width="120" Text="{Binding DateFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="YYYY-MM-DD, or empty for all" />
                <TextBlock Text="Number" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{StaticResource Muted}" />
                <TextBox Width="160" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Search" Command="{Binding RefreshCommand}" Margin="12,0,0,0" IsDefault="True" />
            </StackPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Number" Binding="{Binding TransactionNumber}" Width="170" />
                    <DataGridTextColumn Header="Business date" Binding="{Binding BusinessDate}" Width="105" />
                    <DataGridTextColumn Header="Time (this PC)" Binding="{Binding CompletedUtc, Converter={StaticResource LocalTime}}" Width="130" />
                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="*" />
                    <DataGridTextColumn Header="Paid" Binding="{Binding Method}" Width="70" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalMinor, Converter={StaticResource Money}}" Width="90" />
                    <DataGridTextColumn Header="Refunded" Binding="{Binding CorrectedTotalMinor, Converter={StaticResource Money}}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <TextBlock Text="{Binding DetailHeading}" Style="{StaticResource Subheading}" Margin="0,0,0,8" />
                    <StackPanel Visibility="{Binding Detail, Converter={StaticResource Visible}}">
                        <DataGrid ItemsSource="{Binding Lines}" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Sold" Binding="{Binding Sold}" Width="50" IsReadOnly="True" />
                                <DataGridTextColumn Header="Left" Binding="{Binding Remaining}" Width="50" IsReadOnly="True" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Return" Binding="{Binding ReturnUnits, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridCheckBoxColumn Header="To stock" Binding="{Binding ReturnToStock, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Set Return to the units coming back. Untick To stock for items that are thrown away." />

                        <TextBlock Text="Earlier refunds" Style="{StaticResource Label}" Visibility="{Binding Corrections.Count, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Corrections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Hint}">
                                        <Run Text="{Binding Kind, Mode=OneWay}" /> <Run Text="{Binding TotalMinor, Converter={StaticResource Money}, Mode=OneWay}" />
                                        <Run Text="—" /> <Run Text="{Binding Reason, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Reason (needed for reprint, refund or void)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Print receipt" Command="{Binding PrintOriginalCommand}" />
                            <Button Content="Reprint copy" Command="{Binding ReprintCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Background="#FFFBEB" BorderBrush="#FCD34D"
                                Visibility="{Binding CanRefund, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Refund or void" FontWeight="SemiBold" />
                                <CheckBox IsChecked="{Binding MoneyReturned}" Content="The money has been returned to the customer (same way they paid)" />
                                <StackPanel Visibility="{Binding IsGCashSale, Converter={StaticResource Visible}}">
                                    <TextBlock Text="GCash refund reference (optional)" Style="{StaticResource Label}" />
                                    <TextBox Text="{Binding GCashReference, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <TextBlock Text="Confirm with your password" Style="{StaticResource Label}" />
                                <PasswordBox x:Name="Password" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Refund selected" Style="{StaticResource DangerButton}"
                                            Command="{Binding RefundCommand}" CommandParameter="{Binding ElementName=Password}" />
                                    <Button Content="Void whole sale" Command="{Binding VoidCommand}" CommandParameter="{Binding ElementName=Password}"
                                            Visibility="{Binding CanVoid, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Receipt" Style="{StaticResource Label}" />
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FAFAF9" Padding="12" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ReceiptText}" FontFamily="Consolas" FontSize="12" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

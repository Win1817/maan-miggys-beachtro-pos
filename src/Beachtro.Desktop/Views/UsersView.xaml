<UserControl x:Class="Beachtro.Desktop.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="RoleBox">
            <StackPanel Margin="0,2">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" Margin="0"
                          ToolTip="{Binding Permissions}" />
                <TextBlock Text="{Binding BlockedReason}" Style="{StaticResource Hint}" Margin="24,0,0,0" FontSize="12"
                           Visibility="{Binding BlockedReason, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="{StaticResource Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top" Text="Users" Style="{StaticResource Heading}" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Text="{Binding DelegationNote}" Margin="0,0,0,8" />
            <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBox}" Visibility="{Binding Error, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </Border>
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBox}" Visibility="{Binding Info, Converter={StaticResource Visible}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
            </Border>
            <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                    Visibility="{Binding IssuedPassword, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding IssuedNote}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding IssuedPassword, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="18" Margin="0,8,0,0"
                             AutomationProperties.Name="Temporary password" />
                    <Button Content="I have noted it — hide" Command="{Binding DismissPasswordCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="180" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Reason for the change" Style="{StaticResource Label}" Margin="0" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Reason" />
                    <TextBlock Text="Confirm with your password" Style="{StaticResource Label}" />
                    <PasswordBox x:Name="Password" AutomationProperties.Name="Your password" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="Every account change needs a reason and your password. Both are kept in the audit log (the password is not)." />

                    <TextBlock Text="{Binding SelectedHeading}" Style="{StaticResource Subheading}" Margin="0,20,0,6" />
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding SelectedRoles}" ItemTemplate="{StaticResource RoleBox}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Save roles" Command="{Binding SaveRolesCommand}" CommandParameter="{Binding ElementName=Password}" Margin="0,0,8,8" />
                            <Button Content="Reset password" Command="{Binding ResetPasswordCommand}" CommandParameter="{Binding ElementName=Password}" Margin="0,0,8,8" />
                            <Button Content="{Binding ActiveButtonText}" Command="{Binding ToggleActiveCommand}" CommandParameter="{Binding ElementName=Password}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>

                    <TextBlock Text="New account" Style="{StaticResource Subheading}" Margin="0,20,0,6" />
                    <TextBlock Text="Username" Style="{StaticResource Label}" Margin="0" />
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New username" />
                    <TextBlock Text="Display name" Style="{StaticResource Label}" />
                    <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New display name" />
                    <TextBlock Text="Roles" Style="{StaticResource Label}" />
                    <ItemsControl ItemsSource="{Binding NewRoles}" ItemTemplate="{StaticResource RoleBox}" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="A temporary password is created and shown once. The person must change it at first sign-in." />
                    <Button Content="Create account" Style="{StaticResource Primary}" Command="{Binding CreateCommand}" CommandParameter="{Binding ElementName=Password}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
